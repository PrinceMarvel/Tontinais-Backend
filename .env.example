NODE_ENV=development
PORT=5000

# Base de données MongoDB Atlas
MONGODB_URI=mongodb+srv://TontiNais:DabeJerome@tontinais.xdtbgyd.mongodb.net/?appName=TontiNais

# Authentification JWT
